# Background-removal provider (choose exactly one provider key below)
BG_PROVIDER=removebg
REMOVEBG_API_KEY=
# CLIPDROP_API_KEY=
# PHOTOROOM_API_KEY=
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL_VERSION=

# Per-instance fallback limit. For a global multi-instance limit, add a
# shared rate-limiter before public launch.
RATE_LIMIT_PER_HOUR=20

# Public browser settings. Never put private provider keys in VITE_* variables.
# For local-only ad-flow testing, set both below. Demo mode is disabled in
# production builds even if it is accidentally set in Vercel.
VITE_AD_PROVIDER=demo
VITE_DEMO_AD_MODE=true
# VITE_AD_PROVIDER=admanager
# VITE_AD_REWARDED_SLOT=/1234567/clearcut_rewarded
# VITE_AD_BANNER_SLOT=/1234567/clearcut_banner
